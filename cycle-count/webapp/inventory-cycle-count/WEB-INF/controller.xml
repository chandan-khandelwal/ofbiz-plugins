<site-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Site-Conf"
        xsi:schemaLocation="http://ofbiz.apache.org/Site-Conf http://ofbiz.apache.org/dtds/site-conf.xsd">

    <include location="component://common/webcommon/WEB-INF/common-controller.xml"/>

    <description>Inventory Cycle Count REST API Controller</description>

    <!-- =========================================================
         InventoryCount – CRUD + Query
         Mount point: /inventory-cycle-count/control/...
         All responses chain to the common "json" request-map.
         ========================================================= -->

    <!-- POST  /control/createInventoryCount -->
    <request-map uri="createInventoryCount" method="post">
        <security https="true" auth="true"/>
        <event type="service" invoke="createInventoryCount"/>
        <response name="success" type="request" value="json"/>
        <response name="error"   type="request" value="json"/>
    </request-map>

    <!-- POST  /control/updateInventoryCount -->
    <request-map uri="updateInventoryCount" method="post">
        <security https="true" auth="true"/>
        <event type="service" invoke="updateInventoryCount"/>
        <response name="success" type="request" value="json"/>
        <response name="error"   type="request" value="json"/>
    </request-map>

    <!-- GET   /control/getInventoryCountDetail?inventoryCountId=xxx -->
    <request-map uri="getInventoryCountDetail" method="get">
        <security https="true" auth="true"/>
        <event type="service" invoke="getInventoryCountDetail"/>
        <response name="success" type="request" value="json"/>
        <response name="error"   type="request" value="json"/>
    </request-map>

    <!-- GET   /control/findInventoryCounts?facilityId=&statusId=&... -->
    <request-map uri="findInventoryCounts" method="get">
        <security https="true" auth="true"/>
        <event type="service" invoke="findInventoryCounts"/>
        <response name="success" type="request" value="json"/>
        <response name="error"   type="request" value="json"/>
    </request-map>

    <!-- POST  /control/transitionInventoryCountStatus -->
    <request-map uri="transitionInventoryCountStatus" method="post">
        <security https="true" auth="true"/>
        <event type="service" invoke="transitionInventoryCountStatus"/>
        <response name="success" type="request" value="json"/>
        <response name="error"   type="request" value="json"/>
    </request-map>

    <!-- =========================================================
         InventoryCountItem – CRUD + Query
         ========================================================= -->

    <!-- POST  /control/createInventoryCountItem -->
    <request-map uri="createInventoryCountItem" method="post">
        <security https="true" auth="true"/>
        <event type="service" invoke="createInventoryCountItem"/>
        <response name="success" type="request" value="json"/>
        <response name="error"   type="request" value="json"/>
    </request-map>

    <!-- POST  /control/updateInventoryCountItem -->
    <request-map uri="updateInventoryCountItem" method="post">
        <security https="true" auth="true"/>
        <event type="service" invoke="updateInventoryCountItem"/>
        <response name="success" type="request" value="json"/>
        <response name="error"   type="request" value="json"/>
    </request-map>

    <!-- POST  /control/deleteInventoryCountItem -->
    <request-map uri="deleteInventoryCountItem" method="post">
        <security https="true" auth="true"/>
        <event type="service" invoke="deleteInventoryCountItem"/>
        <response name="success" type="request" value="json"/>
        <response name="error"   type="request" value="json"/>
    </request-map>

    <!-- GET   /control/getInventoryCountItems?inventoryCountId=xxx -->
    <request-map uri="getInventoryCountItems" method="get">
        <security https="true" auth="true"/>
        <event type="service" invoke="getInventoryCountItems"/>
        <response name="success" type="request" value="json"/>
        <response name="error"   type="request" value="json"/>
    </request-map>

    <!-- POST  /control/syncInventoryCountItems
         Body: { inventoryCountId, items: [{uuid, productId, quantity, ...}] }
         Idempotent – safe to call multiple times with the same payload. -->
    <request-map uri="syncInventoryCountItems" method="post">
        <security https="true" auth="true"/>
        <event type="service" invoke="syncInventoryCountItems"/>
        <response name="success" type="request" value="json"/>
        <response name="error"   type="request" value="json"/>
    </request-map>

    <!-- =========================================================
         InventoryCountLock – Acquire / Release / Get
         ========================================================= -->

    <!-- POST  /control/acquireInventoryCountLock -->
    <request-map uri="acquireInventoryCountLock" method="post">
        <security https="true" auth="true"/>
        <event type="service" invoke="acquireInventoryCountLock"/>
        <response name="success" type="request" value="json"/>
        <response name="error"   type="request" value="json"/>
    </request-map>

    <!-- POST  /control/releaseInventoryCountLock -->
    <request-map uri="releaseInventoryCountLock" method="post">
        <security https="true" auth="true"/>
        <event type="service" invoke="releaseInventoryCountLock"/>
        <response name="success" type="request" value="json"/>
        <response name="error"   type="request" value="json"/>
    </request-map>

    <!-- GET   /control/getInventoryCountLock?inventoryCountId=xxx -->
    <request-map uri="getInventoryCountLock" method="get">
        <security https="true" auth="true"/>
        <event type="service" invoke="getInventoryCountLock"/>
        <response name="success" type="request" value="json"/>
        <response name="error"   type="request" value="json"/>
    </request-map>

    <!-- =========================================================
         Default view (required by the common-controller include)
         ========================================================= -->
    <request-map uri="main">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="main"/>
    </request-map>

    <view-map name="main" type="none"/>

</site-conf>